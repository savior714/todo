# Auth.js (Google) — https://authjs.dev/getting-started/installation
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# 배포 시 공개 URL (예: https://todo-nine-mu-90.vercel.app)
AUTH_URL=

# Turso — https://docs.turso.tech/
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# 앱에서 리다이렉트/절대 URL 계산에 사용
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# (선택) 같은 가족에서 공동 양육자 Google 이메일 — 로그인 시 해당 가족의 executor 프로필을 admin으로 승격(멱등). 쉼표로 구분.
# FAMILY_CO_ADMIN_EMAILS=savior714@gmail.com
